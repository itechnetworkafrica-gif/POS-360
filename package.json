{
  "name": "pos360",
  "version": "1.0.0",
  "description": "POS360 — complete point-of-sale platform for Nigerian and African retailers",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/pos360 run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/pos360 run build",
    "start": "pnpm --filter @workspace/api-server run start",
    "db:push": "pnpm --filter @workspace/db run push",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "typecheck:libs": "tsc --build"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
