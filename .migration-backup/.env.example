# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required for all environments)
DATABASE_URL=postgresql://user:password@localhost:5432/pos360

# ── Auth / Session ────────────────────────────────────────────────────────────
# Secret used to sign JWT session cookies — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# ── API server ────────────────────────────────────────────────────────────────
# Port the Express API server listens on (defaults to 8080)
PORT=8080

# Node environment — set to "production" in deployed environments
NODE_ENV=development

# ── CORS (production only) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave blank to allow all (dev only).
# Example: https://pos360.vercel.app,https://www.yourdomain.com
# CORS_ORIGIN=

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error (defaults to "info")
# LOG_LEVEL=info

# ── Object Storage (optional — only needed for file uploads) ──────────────────
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
